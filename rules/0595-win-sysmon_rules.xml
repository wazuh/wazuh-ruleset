<var name="MS_FREQ">8</var>

<group name="windows,sysmon,">
  <rule id="61600" level="0">
    <if_sid>60004</if_sid>
    <field name="win.system.severityValue">^INFORMATION$</field>
    <description>Windows Sysmon informational event</description>
    <options>no_full_log</options>
  </rule>

  <rule id="61601" level="0">
    <if_sid>60004</if_sid>
    <field name="win.system.severityValue">^WARNING$</field>
    <description>Windows Sysmon warning event</description>
    <options>no_full_log</options>
    <group>gpg13_4.12,</group>
  </rule>

  <rule id="61602" level="5">
    <if_sid>60004</if_sid>
    <field name="win.system.severityValue">^ERROR$</field>
    <description>Windows Sysmon error event</description>
    <options>no_full_log</options>
    <group>system_error,gpg13_4.3,gdpr_IV_35.7.d,</group>
  </rule>

  <rule id="61603" level="0">
    <if_sid>61600</if_sid>
    <field name="win.system.eventID">^1$</field>
    <description>Sysmon - Event 1: Process creation (Image: $(win.eventdata.image), Parent: $(win.eventdata.parentImage), Cmd: $(win.eventdata.commandLine))</description>
    <options>no_full_log</options>
    <group>sysmon_event1,</group>
  </rule>

  <rule id="61604" level="0">
    <if_sid>61600</if_sid>
    <field name="win.system.eventID">^2$</field>
    <description>Sysmon - Event 2: File creation time changed (SourceImage: $(win.eventdata.sourceImage))</description>
    <options>no_full_log</options>
    <group>sysmon_event2,</group>
  </rule>

  <rule id="61605" level="0">
    <if_sid>61600</if_sid>
    <field name="win.system.eventID">^3$</field>
    <description>Sysmon - Event 3: Network connection (SourceImage: $(win.eventdata.sourceImage), Destination: $(win.eventdata.destinationIp):$(win.eventdata.destinationPort))</description>
    <options>no_full_log</options>
    <group>sysmon_event3,</group>
  </rule>

  <rule id="61606" level="0">
    <if_sid>61600</if_sid>
    <field name="win.system.eventID">^4$</field>
    <description>Sysmon - Event 4: Sysmon service state changed (SourceImage: $(win.eventdata.sourceImage))</description>
    <options>no_full_log</options>
    <group>sysmon_event4,</group>
  </rule>

  <rule id="61607" level="0">
    <if_sid>61600</if_sid>
    <field name="win.system.eventID">^5$</field>
    <description>Sysmon - Event 5: Process terminated (Image: $(win.eventdata.image))</description>
    <options>no_full_log</options>
    <group>sysmon_event5,</group>
  </rule>

  <rule id="61608" level="0">
    <if_sid>61600</if_sid>
    <field name="win.system.eventID">^6$</field>
    <description>Sysmon - Event 6: Driver loaded (ImageLoaded: $(win.eventdata.imageLoaded), Hashes: $(win.eventdata.hashes))</description>
    <options>no_full_log</options>
    <group>sysmon_event6,</group>
  </rule>

  <rule id="61609" level="0">
    <if_sid>61600</if_sid>
    <field name="win.system.eventID">^7$</field>
    <description>Sysmon - Event 7: Image loaded (Image: $(win.eventdata.image), ImageLoaded: $(win.eventdata.imageLoaded))</description>
    <options>no_full_log</options>
    <group>sysmon_event7,</group>
  </rule>

  <rule id="61610" level="0">
    <if_sid>61600</if_sid>
    <field name="win.system.eventID">^8$</field>
    <description>Sysmon - Event 8: CreateRemoteThread (SourceImage: $(win.eventdata.sourceImage), TargetImage: $(win.eventdata.targetImage))</description>
    <options>no_full_log</options>
    <group>sysmon_event8,</group>
  </rule>

  <rule id="61611" level="0">
    <if_sid>61600</if_sid>
    <field name="win.system.eventID">^9$</field>
    <description>Sysmon - Event 9: RawAccessRead (SourceImage: $(win.eventdata.sourceImage), Device: $(win.eventdata.device))</description>
    <options>no_full_log</options>
    <group>sysmon_event9,</group>
  </rule>

  <rule id="61612" level="0">
    <if_sid>61600</if_sid>
    <field name="win.system.eventID">^10$</field>
    <description>Sysmon - Event 10: ProcessAccess (SourceImage: $(win.eventdata.sourceImage), TargetImage: $(win.eventdata.targetImage))</description>
    <options>no_full_log</options>
    <group>sysmon_event_10,</group>
  </rule>

  <rule id="61613" level="0">
    <if_sid>61600</if_sid>
    <field name="win.system.eventID">^11$</field>
    <description>Sysmon - Event 11: FileCreate (TargetFilename: $(win.eventdata.targetFilename), Image: $(win.eventdata.image))</description>
    <options>no_full_log</options>
    <group>sysmon_event_11,</group>
  </rule>

  <rule id="61614" level="0">
    <if_sid>61600</if_sid>
    <field name="win.system.eventID">^12$</field>
    <description>Sysmon - Event 12: Registry key create/delete (TargetObject: $(win.eventdata.targetObject), Image: $(win.eventdata.image))</description>
    <options>no_full_log</options>
    <group>sysmon_event_12,</group>
  </rule>

  <rule id="61615" level="0">
    <if_sid>61600</if_sid>
    <field name="win.system.eventID">^13$</field>
    <description>Sysmon - Event 13: Registry value set (TargetObject: $(win.eventdata.targetObject), Details: $(win.eventdata.details), Image: $(win.eventdata.image))</description>
    <options>no_full_log</options>
    <group>sysmon_event_13,</group>
  </rule>

  <rule id="61616" level="0">
    <if_sid>61600</if_sid>
    <field name="win.system.eventID">^14$</field>
    <description>Sysmon - Event 14: Registry key/value rename (TargetObject: $(win.eventdata.targetObject), NewName: $(win.eventdata.newName), Image: $(win.eventdata.image))</description>
    <options>no_full_log</options>
    <group>sysmon_event_14,</group>
  </rule>

  <rule id="61617" level="0">
    <if_sid>61600</if_sid>
    <field name="win.system.eventID">^15$</field>
    <description>Sysmon - Event 15: FileCreateStreamHash (TargetFilename: $(win.eventdata.targetFilename), Hash: $(win.eventdata.hash))</description>
    <options>no_full_log</options>
    <group>sysmon_event_15,</group>
  </rule>
</group>

<group name="windows,sysmon,sysmon_process-anomalies,">
