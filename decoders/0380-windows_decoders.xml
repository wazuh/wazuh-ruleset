<!-- ========================= -->
<!-- Windows Defender decoders  -->
<!-- ========================= -->

<decoder name="Windows-defender">
  <parent>windows</parent>
  <type>windows</type>
  <prematch>Microsoft-Windows-Windows Defender/Operational:\s+\S+\(1\d\d\d\)</prematch>
  <regex>Microsoft-Windows-Windows Defender/Operational:\s+\S+\((\d+)\)</regex>
  <order>id</order>
</decoder>

<decoder name="Windows-defender">
  <parent>windows</parent>
  <type>windows</type>
  <regex offset="after_regex">Name:\s+(.+?)\s+ID:\s+(.+?)\s+Severity:\s+(.+?)\s+Category:\s+(.+?)\s+Path:\s+\S+:(.+?)\s+Detection</regex>
  <order>defender.name, defender.id, defender.severity, defender.category, defender.pathfound</order>
</decoder>

<decoder name="Windows-defender">
  <parent>windows</parent>
  <type>windows</type>
  <regex offset="after_regex">Type:\s+(.+?)\s+Detection Source:\s+(.+?)\s+User:\s+(.+?)\s+Process Name:\s+(.+?)\s+Signature</regex>
  <order>defender.detectiontype, defender.detectionsource, srcuser, defender.processname</order>
</decoder>

<decoder name="Windows-defender">
  <parent>windows</parent>
  <type>windows</type>
  <regex offset="after_regex">Name:\s+(.+?)\s+ID:\s+(.+?)\s+Severity:\s+(.+?)\s+Category:\s+(.+?)\s+Path:\s+\S+:(.+?);</regex>
  <order>defender.name, defender.id, defender.severity, defender.category, defender.path</order>
</decoder>

<decoder name="Windows-defender">
  <parent>windows</parent>
  <type>windows</type>
  <regex offset="after_regex">User:\s+(.+?)\s+(?:Process Name:|Action:)</regex>
  <order>srcuser</order>
</decoder>

<decoder name="Windows-defender">
  <parent>windows</parent>
  <type>windows</type>
  <regex offset="after_regex">Process Name:\s+(.+?)\s+Action:\s+(\S+)</regex>
  <order>defender.processname, defender.action</order>
</decoder>

<!-- Windows Defender END -->



<!-- ========================= -->
<!-- Terminal Services Gateway  -->
<!-- ========================= -->

<decoder name="TerminalServices-Gateway">
  <type>windows</type>
  <parent>windows</parent>
  <prematch>Microsoft-Windows-TerminalServices-Gateway/Operational</prematch>
  <regex>^(Microsoft-Windows-TerminalServices-Gateway/Operational):\s+(\w+)\((\d+)\):\s+.+:\s+</regex>
  <regex>(.+):\s+.+:\s+(\S+):\s+</regex>
  <order>type, status, id, account, system_name</order>
  <fts>name, location, system_name</fts>
</decoder>

<decoder name="TerminalServices-Gateway">
  <parent>windows</parent>
  <type>windows</type>
  <regex offset="after_regex">The user "(.+?)", on client computer "(.+?)",</regex>
  <order>user, dstip</order>
</decoder>

<decoder name="TerminalServices-Gateway">
  <parent>windows</parent>
  <type>windows</type>
  <regex offset="after_regex">resource\s+"(.+?)"</regex>
  <order>resource</order>
</decoder>

<decoder name="TerminalServices-Gateway">
  <parent>windows</parent>
  <type>windows</type>
  <regex offset="after_regex">authentication method used was:\s+"(.+?)"</regex>
  <order>auth_method</order>
</decoder>

<decoder name="TerminalServices-Gateway">
  <parent>windows</parent>
  <type>windows</type>
  <regex offset="after_regex">connection protocol used:\s+"(.+?)"</regex>
  <order>protocol</order>
</decoder>

<decoder name="TerminalServices-Gateway">
  <parent>windows</parent>
  <type>windows</type>
  <regex offset="after_regex">using\s+(.+?)\s+connection protocol\.</regex>
  <order>protocol</order>
</decoder>

<decoder name="TerminalServices-Gateway">
  <parent>windows</parent>
  <type>windows</type>
  <regex offset="after_regex">error occurred:\s+"(.+?)"</regex>
  <order>error_code</order>
</decoder>

<!-- Terminal Services END -->



