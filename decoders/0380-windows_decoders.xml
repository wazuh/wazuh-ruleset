<!-- Windows - NTsyslog format  -->
<!-- ========================= -->

<decoder name="windows-ntsyslog">
  <type>windows</type>
  <prematch>^security\[\w+\]\s+\d+\s+</prematch>
  <regex>^(\w+)\[(\w+)\]\s+(\d+)\s+</regex>
  <order>extra_data, status, id</order>
</decoder>



<!-- ========================= -->
<!-- Windows - Snare format     -->
<!-- ========================= -->

<decoder name="windows-snare">
  <type>windows</type>
  <prematch>^MSWinEventLog\t\d\t.+\t\d+\t\w\w\S+\s+\w\w\w\s+\d\d\s+\d\d</prematch>
  <regex offset="after_prematch">^:\d\d:\d\d\s+\d\d\d\d\t(\d+)\t(.+)</regex>
  <regex>\t(.+)\t.+\t(.+)\t(.+)\t</regex>
  <order>id, extra_data, user, status, system_name</order>
  <fts>name, id, location, user, system_name</fts>
</decoder>
