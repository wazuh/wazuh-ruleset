<!-- Sysmon decoders            -->
<!-- ========================= -->

<!-- Event ID 1: Process Created (OLD - HashType/Hash) -->
<decoder name="Sysmon-EventID#1">
  <parent>windows</parent>
  <type>windows</type>
  <prematch>Microsoft-Windows-Sysmon/Operational: INFORMATION\(1\).+HashType</prematch>
  <regex>Image:\s+(.+?)\s+CommandLine:\s+(.+?)\s+User:\s+(.+?)\s+LogonGuid:\s+\S+\s+LogonId:\s+\S+\s+TerminalSessionId:\s+\S+\s+IntegrityLevel:\s+(.+?)\s+HashType:\s+\S+\s+Hash:\s+(\S+)\s+ParentProcessGuid:\s+\S+\s+ParentProcessId:\s+\S+\s+ParentImage:\s+(.+?)\s+ParentCommandLine:\s+(.+?)\s*$</regex>
  <order>sysmon.image, sysmon.commandLine, srcuser, sysmon.integrityLevel, sysmon.hash, sysmon.parentImage, sysmon.parentCommandLine</order>
</decoder>


<!-- Event ID 1: Process Created (NEW - Hashes, multi-stage parse) -->
<decoder name="Sysmon-EventID#1_new">
  <parent>windows</parent>
  <type>windows</type>
  <prematch>Microsoft-Windows-Sysmon/Operational: INFORMATION\(1\).+Hashes</prematch>
  <regex>Microsoft-Windows-Sysmon/Operational:\s+\S+\((\d+)\)</regex>
  <order>id</order>
</decoder>

<decoder name="Sysmon-EventID#1_new">
  <parent>windows</parent>
  <type>windows</type>
  <regex offset="after_regex">ProcessGuid:\s+(\{[^\}]+\})\s+ProcessId:\s+(\d+)\s+Image:\s+(.+?)\s+CommandLine:\s+(.+?)\s+CurrentDirectory:</regex>
  <order>sysmon.processGuid, sysmon.processId, sysmon.image, sysmon.commandLine</order>
</decoder>

<decoder name="Sysmon-EventID#1_new">
  <parent>windows</parent>
  <type>windows</type>
  <regex offset="after_regex">CurrentDirectory:\s+(.+?)\s+User:\s+(.+?)\s+LogonGuid:\s+(\{[^\}]+\})\s+LogonId:\s+(\S+)\s+TerminalSessionId:\s+(\S+)\s+IntegrityLevel:\s+(.+?)\s+Hashes:\s+(.+?)\s+ParentProcessGuid:\s+(\{[^\}]+\})\s+ParentProcessId:\s+(\d+)\s+ParentImage:\s+(.+?)\s+ParentCommandLine:</regex>
  <order>sysmon.currentDirectory, srcuser, sysmon.logonGuid, sysmon.logonId, sysmon.terminalSessionId, sysmon.integrityLevel, sysmon.hashes, sysmon.parentProcessGuid, sysmon.parentProcessId, sysmon.parentImage</order>
</decoder>

<decoder name="Sysmon-EventID#1_new">
  <parent>windows</parent>
  <type>windows</type>
  <regex offset="after_regex">ParentCommandLine:\s+"?(.+?)"?\s*$</regex>
  <order>sysmon.parentCommandLine</order>
</decoder>


<!-- Event ID 2: File creation time changed -->
<decoder name="Sysmon-EventID#2">
  <parent>windows</parent>
  <type>windows</type>
  <prematch>Microsoft-Windows-Sysmon/Operational: INFORMATION\(2\)</prematch>
  <regex>Microsoft-Windows-Sysmon/Operational:\s+\S+\((\d+)\)</regex>
  <order>id</order>
</decoder>

<decoder name="Sysmon-EventID#2">
  <parent>windows</parent>
  <type>windows</type>
  <regex offset="after_regex">Image:\s+(.+?)\s+TargetFilename:\s+(.+?)\s+CreationUtcTime:\s+(.+?)\s+PreviousCreationUtcTime:\s+(.+?)\s*$</regex>
  <order>sysmon.image, sysmon.targetfilename, sysmon.creationUtcTime, sysmon.previousCreationUtcTime</order>
</decoder>


<!-- Event ID 3: Network connection -->
<decoder name="Sysmon-EventID#3">
  <parent>windows</parent>
  <type>windows</type>
  <prematch>Microsoft-Windows-Sysmon/Operational: INFORMATION\(3\)</prematch>
  <regex>Microsoft-Windows-Sysmon/Operational:\s+\S+\((\d+)\)</regex>
  <order>id</order>
</decoder>

<decoder name="Sysmon-EventID#3">
  <parent>windows</parent>
  <type>windows</type>
  <regex offset="after_regex">ProcessGuid:\s+(\{[^\}]+\})\s+ProcessId:\s+(\d+)\s+Image:\s+(.+?)\s+User:\s+(.+?)\s+Protocol:\s+(\S+)\s+Initiated:\s+(\S+)\s+SourceIsIpv6:\s+(\S+)\s+SourceIp:\s+(\S+)\s+SourceHostname:\s+(.+?)\s+SourcePort:\s+(\S+)\s+SourcePortName:\s*(.*?)\s+DestinationIsIpv6:\s+(\S+)\s+DestinationIp:\s+(\S+)\s+DestinationHostname:\s+(.+?)\s+DestinationPort:\s+(\S+)\s+DestinationPortName:\s*(\S*)\s*$</regex>
  <order>sysmon.processGuid, sysmon.processId, sysmon.image, srcuser, protocol, sysmon.initiated, sysmon.sourceIsIpv6, srcip, sysmon.sourceHostname, srcport, sysmon.srcPortName, sysmon.destinationIsIpv6, dstip, sysmon.destinationHostname, dstport, sysmon.dstPortName</order>
</decoder>


<!-- Event ID 4: Sysmon service state changed -->
<decoder name="Sysmon-EventID#4">
  <parent>windows</parent>
  <type>windows</type>
  <prematch>Microsoft-Windows-Sysmon/Operational: INFORMATION\(4\)</prematch>
  <regex>Microsoft-Windows-Sysmon/Operational:\s+\S+\((\d+)\)</regex>
